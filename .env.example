DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
AUTH_SECRET=replace-with-a-random-32-byte-secret

# Required in production when self-hosting behind a proxy/host that isn't
# Vercel (Vercel sets this automatically). See:
# https://authjs.dev/reference/next-auth/errors#untrustedhost
# AUTH_TRUST_HOST=true
